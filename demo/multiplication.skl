# Function: multiplication left * right
# Inputs: left, right
# Output: result

input left
input right

multInputLeft = left
multInputRight = right

multCounter = multInputLeft
clear multResult

while multCounter <> 0 do
  multAddend = multInputRight
  while multAddend <> 0 do
    incr multResult
    decr multAddend
  end
  decr multCounter
end

result = multResult

output result
